# Copy to .env

# Docker
CLUTCHBOT_TAG=1.0.0
TZ=UTC

# osu!
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=change-me

# Twitter
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Behaviour
DRY_RUN=true # process everything but don't post to twitter
POLL_INTERVAL_SECONDS=600
MATCH_EXPIRY_HOURS=24

# Processing
CLUTCH_THRESHOLD_PERCENT=5
WARMUP_GAMES_CHECKED=2

# Paths
DATA_DIR=data
# default:$DATA_DIR/acronyms.json
ACRONYMS_PATH=

# Logging & metrics
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# text (readable) or json (one JSON object per line, for log collectors like Loki);
# docker-compose.yml defaults to json
LOG_FORMAT=text
# Serve Prometheus metrics on this port. empty = off (docker-compose.yml uses 9102)
METRICS_PORT=
# Docker network shared with Prometheus (docker-compose.yml only)
MONITORING_NETWORK=monitoring

# Alerts with ntfy
NTFY_URL=
