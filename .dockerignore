# Only pyproject.toml, uv.lock, README.md, LICENSE and src/ are needed to build the image

# Secrets and local state never go into the image
.env
.env.*
data/
output/
*.db

# Development only
.git/
.venv/
tests/
scripts/
*.local.md
.pre-commit-config.yaml
acronyms.example.json

# Caches
**/__pycache__/
**/*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
